POSTGRES_DB=aioj
POSTGRES_USER=aioj
POSTGRES_PASSWORD=change-this-postgres-password

REDIS_PASSWORD=change-this-redis-password

MINIO_ROOT_USER=aiojadmin
MINIO_ROOT_PASSWORD=change-this-minio-password
S3_PUBLIC_ENDPOINT=https://example.com

INTERNAL_API_TOKEN=change-this-long-random-internal-token
JWT_SECRET=change-this-long-random-jwt-secret

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password

CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com,http://127.0.0.1:8000,http://localhost:8000

# Optional node name for a legacy/external judge agent running outside docker compose.
JUDGE_NODE_NAME=api-local-worker
# Default node name for the compose-managed worker container.
WORKER_NODE_NAME=compose-worker
JUDGE_NODE_TAGS=cpu
JUDGE_NODE_MAX_PARALLEL=1
JUDGE_HEARTBEAT_INTERVAL_SECONDS=15
AIOJ_JUDGE_INTERVAL=3
AIOJ_HOST_RUN_ROOT=/opt/aioj/runs

# Development only. Keep false in production so untrusted submissions never run in the worker process.
AIOJ_ALLOW_LOCAL_JUDGE_RUNNER=false
MAX_PROBLEM_ZIP_MB=512
MAX_PROBLEM_FILES=2000
MAX_PROBLEM_UNCOMPRESSED_MB=2048

# Optional scorer/runtime settings for heavy ML tasks.
AIOJ_SCORER_TIMEOUT_SEC=900
HF_HOME=
HF_TOKEN=
HUGGINGFACE_HUB_TOKEN=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
